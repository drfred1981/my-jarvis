# Discord
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_IDS=             # "Always-on" channels. Either a CSV of ids ("123,456") OR a JSON list with minimal context: [{"id":"123","description":"Pilotage du repo X"},{"id":"456","description":"Domotique"}]. id required, description optional (inferred otherwise). Seeds each conversation's cadrage.
DISCORD_INVOCATION_PREFIX=/claude  # Multi-user channels: act only on this prefix or @mention
DISCORD_HISTORY_LIMIT=15           # Recent channel msgs fed as context in multi-user channels
DISCORD_REPO_PARENT_CHANNEL_ID=    # Parent channel where the agent creates one thread per managed repo

# Home Assistant
HA_URL=http://homeassistant.default.svc.cluster.local:8123
HA_TOKEN=

# Git repositories (JSON dict: {"alias": "url", ...})
GIT_REPOS={"infra":"https://github.com/username/home-k8s-infra.git","apps":"https://github.com/username/home-k8s-apps.git","jarvis":"https://github.com/username/my-jarvis.git"}
GITHUB_TOKEN=

# Grafana / Prometheus
GRAFANA_URL=http://grafana.monitoring.svc.cluster.local:3000
GRAFANA_TOKEN=
PROMETHEUS_URL=http://prometheus.monitoring.svc.cluster.local:9090

# Planka (project management)
PLANKA_URL=http://planka.default.svc.cluster.local:1337
PLANKA_USER=
PLANKA_PASSWORD=

# Miniflux (RSS reader)
MINIFLUX_URL=http://miniflux.default.svc.cluster.local:8080
MINIFLUX_API_KEY=

# Immich (photos)
IMMICH_URL=http://immich.default.svc.cluster.local:2283
IMMICH_API_KEY=

# Karakeep (bookmarks)
KARAKEEP_URL=http://karakeep.default.svc.cluster.local:3000
KARAKEEP_API_KEY=

# DocMost (wiki) - API key (enterprise) OR user/password (self-hosted)
DOCMOST_URL=
DOCMOST_API_KEY=              # Enterprise edition only
DOCMOST_USER=                 # Email for login auth (alternative to API key)
DOCMOST_PASSWORD=             # Password for login auth

# Music Assistant
MUSIC_ASSISTANT_URL=http://music-assistant.default.svc.cluster.local:8095

# Synology Chat (optional)
SYNOLOGY_CHAT_WEBHOOK_URL=

# Synology Router (optional)
SRM_URL=
SRM_USER=
SRM_PASSWORD=

# Plex (optional)
PLEX_URL=
PLEX_TOKEN=

# Homebox (home inventory, optional)
HOMEBOX_URL=
HOMEBOX_USER=
HOMEBOX_PASSWORD=

# LubeLogger (vehicle maintenance, optional)
LUBELOG_URL=
LUBELOG_API_KEY=

# Gatus (status page)
GATUS_URL=
GATUS_USER=                   # Optional, for protected endpoints
GATUS_PASSWORD=               # Optional, for protected endpoints

# MIND (reminders/notifications, optional)
MIND_URL=
MIND_USER=
MIND_PASSWORD=

# Alertmanager (alerts management)
ALERTMANAGER_URL=http://alertmanager.observability.svc.cluster.local:9093

# Jarvis limits
JARVIS_MAX_BUDGET=1.00        # Max USD per request
JARVIS_MAX_TURNS=10           # Max agentic turns per request

# Proactive monitoring — Track A (infra health checks)
JARVIS_MONITORING=true         # Enable/disable infra health checks
JARVIS_MONITOR_FLOOR_MIN=15    # Firm cadence floor (min) — checks never run faster

# Night mode (quiet hours) — suppresses BOTH proactive tracks; reactive chat unaffected
JARVIS_QUIET_HOURS=00:00-07:00 # Local time window "HH:MM-HH:MM" (wrap-around OK)

# Autonomous introspection — Track B (adaptive exponential backoff + coaching)
JARVIS_INTROSPECTION=true      # Enable/disable the idle introspection loop
JARVIS_INTROSPECT_FLOOR_MIN=15 # Idle timer floor (min), doubles each idle cycle…
JARVIS_INTROSPECT_CAP_MIN=300  # …up to this cap (min). 300 = 5h
JARVIS_COACHING_ACTIVE_HOURS=24            # Per-conversation coaching targets convs active within N h
DISCORD_COACHING_CHANNEL_ID=   # Optional: dedicated channel for the team perimeter review. If unset, the review is logged only — NEVER broadcast.
JARVIS_MONITOR_CHANNEL_ID=     # Optional: single dedicated channel for infra monitoring (Track A). If unset, falls back to the coaching channel, else log-only — never broadcast into conversation channels.

# Skills — two layers (figé/amendment). Defaults are correct for the shipped image.
JARVIS_SKILLS_SEED_DIR=/opt/jarvis/seed/skills  # repo skills (frozen, read-only, wins on collision)
JARVIS_SKILLS_DIR=/home/jarvis/skills           # runtime skills (volume, where create_skill writes)

# Environment
ENV=development
